OPENAI_API_KEY=replace_with_your_own_key
OPENAI_MODEL=gpt-4.1-mini
# Optional: real contact address required by SEC fair-access policy
SEC_USER_AGENT=AI Stock Finder Research contact@example.com

# Paid AI OFF by default, especially on public Streamlit Community Cloud.
ENABLE_PAID_AI=false
# Local single-user limits only; not secure multi-user identification.
LOCAL_USER_ID=local-owner
GLOBAL_DAILY_LIMIT=20
